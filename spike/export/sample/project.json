      "tables": {
        "issues": [
          { "no": 1, "remark": "RTU-1: supply fan belt worn; replaced during TAB.", "status": "Closed", "comments": "A42 belt replaced 9/15." },
          { "no": 2, "remark": "VAV-2 fan-powered box: fan CFM 1 % low at max speed.", "status": "Open", "comments": "Controls contractor to verify ECM setting." }
        ]
      }
    },

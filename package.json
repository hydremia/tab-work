{
  "name": "tab-work",
  "private": true,
  "description": "a2b TAB workbook and the TAB App (npm workspaces: app, packages/*, spike/export)",
  "workspaces": [
    "packages/*",
    "app",
    "spike/export"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "lint": "eslint app packages",
    "typecheck": "npm run typecheck -w @a2b/workbook && npm run typecheck -w app",
    "test": "npm run test -w @a2b/workbook && npm run test -w app",
    "format": "prettier --write app packages",
    "spike": "npm run spike -w spike/export"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "@types/node": "^22.0.0"
  }
}

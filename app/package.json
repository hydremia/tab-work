{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "a2b TAB App: offline-first PWA for TAB field data entry",
  "scripts": {
    "copy-template": "node scripts/copy-template.mjs",
    "predev": "npm run copy-template",
    "dev": "vite",
    "prebuild": "npm run copy-template",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "e2e": "tsx e2e/run-e2e.ts"
  },
  "dependencies": {
    "@a2b/workbook": "*",
    "@supabase/supabase-js": "^2.100.0",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.0",
    "jpeg-js": "^0.4.4",
    "jsdom": "^27.0.0",
    "playwright-core": "1.56.1",
    "tsx": "^4.23.15",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.1.0"
  }
}
